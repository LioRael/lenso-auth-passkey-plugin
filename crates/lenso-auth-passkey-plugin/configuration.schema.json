{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "database_url_secret",
    "receipt_encryption_key_secret",
    "rp_id",
    "rp_name",
    "allowed_origins",
    "auth_issuer",
    "auth_public_key",
    "management_callers",
    "authentication_callers",
    "audience",
    "challenge_ttl_seconds",
    "session_ttl_seconds",
    "receipt_ttl_seconds",
    "max_passkeys_per_subject"
  ],
  "properties": {
    "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
    "database_url_secret": { "type": "string", "minLength": 1, "maxLength": 256 },
    "receipt_encryption_key_secret": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rp_id": { "type": "string", "minLength": 1, "maxLength": 253 },
    "rp_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "auth_issuer": { "type": "string", "minLength": 1, "maxLength": 128 },
    "auth_public_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "management_callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "authentication_callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "challenge_ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 900 },
    "session_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
    "receipt_ttl_seconds": { "type": "integer", "minimum": 300, "maximum": 604800 },
    "max_passkeys_per_subject": { "type": "integer", "minimum": 1, "maximum": 64 }
  }
}
